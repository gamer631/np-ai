# Add at least one provider key. Never commit real API keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Durable chat quotas (Upstash Redis REST). Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Generate a unique random secret (at least 32 bytes) for hashing client identifiers.
# Example: openssl rand -hex 32
RATE_LIMIT_SALT=
